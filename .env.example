# =============================================================================
# Black Friday Chile Price Hunter Bot - Variables de Entorno
# Copia este archivo a `.env` y completa tus credenciales.
# =============================================================================

# --- Base de Datos (Supabase PostgreSQL via asyncpg) ---
# Usa el Transaction Pooler (puerto 6543) de Supabase en producción (Railway).
# Ejemplo: postgresql+asyncpg://postgres.<project_ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Reglas de Detección de Anomalías ---
# Porcentaje de caída mínimo para clasificar como PRICE_ERROR (dispara Twilio + Telegram)
EXTREME_DISCOUNT_THRESHOLD=70
# Porcentaje de caída mínimo respecto a mediana 30d para HISTORICAL_LOW (dispara Telegram)
HISTORICAL_LOW_MIN_DROP=10
# Ventana histórica en días para mediana y mínimo
HISTORY_WINDOW_DAYS=30
# Horas de cooldown por producto y mismo precio (evita alertas repetidas)
ALERT_COOLDOWN_HOURS=6
# Arranque en frío: precio máximo en CLP (con stock) considerado error absurdo sin historial previo
COLD_START_ABSURD_PRICE_CLP=1000

# --- Alertas Nivel 1 y 2: Telegram Bot API ---
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=123456789

# --- Alertas Nivel 2 (PRICE_ERROR >= 70%): Twilio Voice API ---
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Número comprado/verificado en Twilio en formato E.164
TWILIO_FROM_NUMBER=+15551234567
# Tu número de teléfono en Chile en formato E.164
TWILIO_TO_NUMBER=+56912345678
TWILIO_VOICE_NAME=Polly.Mia
TWILIO_VOICE_LANGUAGE=es-MX
# Rate limit global de llamadas telefónicas en segundos (ej. 180 = máximo 1 llamada cada 3 minutos)
# Protege contra tormentas de llamadas ante errores masivos; Telegram SIEMPRE se envía.
TWILIO_GLOBAL_COOLDOWN_SECONDS=180

# --- Scraping & Antibloqueo ---
# Lista opcional de proxies separados por coma (ej: http://user:pass@host1:8000,http://user:pass@host2:8000)
PROXY_URLS=
MAX_CONCURRENT_REQUESTS=4
REQUEST_MIN_DELAY_SEC=1.0
REQUEST_MAX_DELAY_SEC=3.0
HTTP_TIMEOUT_SECONDS=25
PLAYWRIGHT_FALLBACK_ENABLED=true
# Incluir precios exclusivos de tarjeta de la tienda (ej. CMR) además de todo medio de pago
INCLUDE_STORE_CARD_PRICES=true

# --- Orquestación (APScheduler) ---
TARGETS_CONFIG_PATH=config/targets.yaml
WATCHLIST_INTERVAL_MINUTES=3
CATEGORY_INTERVAL_MINUTES=10
LOG_LEVEL=INFO
